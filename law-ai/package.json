{
  "name": "apex-counsel-ai",
  "version": "0.1.0",
  "description": "Legal AI assistant for law students and lawyers (UK, US, Pakistan) by United Apex Developers",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "ingest:pk": "python3 ingest/pakistan.py",
    "ingest:uk": "python3 ingest/uk.py",
    "ingest:us": "python3 ingest/us.py && python3 ingest/us_constitution.py"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "express": "^5.3.0"
  }
}
